generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  shopifyStores       ShopifyStore[]
  systemLogs          SystemLog[]

  @@map("users")
}

model RefreshSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Shopify store + brand
// ---------------------------------------------------------------------------

model ShopifyStore {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopDomain            String    @unique
  accessTokenEncrypted  String
  scopes                String
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  brandSettings        BrandSettings?
  aiSettings           AiSettings?
  products             Product[]
  collections          Collection[]
  reviewerProfiles     ReviewerProfile[]
  reviewProviderConfigs ReviewProviderConfig[]
  bulkGenerationJobs   BulkGenerationJob[]
  duplicateCheckJobs   DuplicateCheckJob[]

  @@index([userId])
  @@map("shopify_stores")
}

model BrandSettings {
  id               String       @id @default(cuid())
  storeId          String       @unique
  store            ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brandName        String
  brandDescription String       @db.Text
  brandCategory    String
  brandPositioning String       @db.Text
  brandPersonality String       @db.Text
  brandVoice       String       @db.Text
  targetAudience   String       @db.Text
  usp              String?      @db.Text
  country          String
  language         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("brand_settings")
}

// ---------------------------------------------------------------------------
// Product catalog (synced from Shopify)
// ---------------------------------------------------------------------------

model Product {
  id                String    @id @default(cuid())
  storeId           String
  store             ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyProductId  String
  handle            String
  title             String
  description       String    @db.Text
  vendor            String
  productType       String
  tags              String[]
  status            String
  lastAnalyzedAt    DateTime?
  detectedAudience  ProductAudience?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  images            ProductImage[]
  variants          ProductVariant[]
  collections       ProductCollection[]
  reviews           GeneratedReview[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId])
  @@map("products")
}

/** Cached result of vision-based audience analysis (see apps/worker/src/reviews/vision-audience.ts)
 * — set once per product (lastAnalyzedAt marks that analysis was attempted, this holds the
 * result), reused on every later review generation instead of re-analyzing the image each time. */
enum ProductAudience {
  MALE
  FEMALE
  UNISEX
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  position     Int
  analysis     Json?
  analyzedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyVariantId String
  title            String
  sku              String?
  price            Decimal  @db.Decimal(10, 2)
  options          Json
  createdAt        DateTime @default(now())

  @@unique([productId, shopifyVariantId])
  @@map("product_variants")
}

model Collection {
  id                   String   @id @default(cuid())
  storeId              String
  store                ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyCollectionId  String
  title                String
  handle               String
  sortOrder            String?
  createdAt            DateTime @default(now())

  products ProductCollection[]

  @@unique([storeId, shopifyCollectionId])
  @@index([storeId])
  @@map("collections")
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([productId, collectionId])
  @@map("product_collections")
}

// ---------------------------------------------------------------------------
// Reviewers + generated reviews
// ---------------------------------------------------------------------------

enum ReviewerGender {
  FEMALE
  MALE
}

model ReviewerProfile {
  id                 String         @id @default(cuid())
  storeId            String
  store              ShopifyStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  gender             ReviewerGender
  country            String
  ageGroup           String
  occupation         String
  isVerifiedPurchase Boolean        @default(false)
  createdAt          DateTime       @default(now())

  reviews GeneratedReview[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("reviewer_profiles")
}

enum ReviewStatus {
  DRAFT
  APPROVED
  QUEUED
  UPLOADED
  FAILED
  DUPLICATE_REGENERATED
}

model GeneratedReview {
  id                    String          @id @default(cuid())
  productId             String
  product               Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerProfileId     String
  reviewerProfile       ReviewerProfile @relation(fields: [reviewerProfileId], references: [id], onDelete: Cascade)
  rating                Int
  title                 String
  content               String          @db.Text
  contentEmbeddingHash  String
  status                ReviewStatus    @default(DRAFT)
  reviewDate            DateTime
  images                Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  uploadJobs UploadJob[]
  duplicateCheckFlags DuplicateCheckFlag[]

  @@index([productId])
  @@index([reviewerProfileId])
  @@index([contentEmbeddingHash])
  @@index([status])
  @@index([createdAt])
  @@map("generated_reviews")
}

// ---------------------------------------------------------------------------
// Review provider + upload queue
// ---------------------------------------------------------------------------

enum ReviewProviderName {
  AG_PRODUCT_REVIEWS
  JUDGE_ME
  LOOX
  FERA
  RYVIU
}

model ReviewProviderConfig {
  id                    String             @id @default(cuid())
  storeId               String
  store                 ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider              ReviewProviderName
  credentialsEncrypted  String
  isActive              Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  uploadJobs UploadJob[]

  @@unique([storeId, provider])
  @@index([storeId])
  @@map("review_provider_configs")
}

enum UploadJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model UploadJob {
  id               String               @id @default(cuid())
  reviewId         String
  review           GeneratedReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  providerConfigId String
  providerConfig   ReviewProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  status           UploadJobStatus      @default(PENDING)
  attempts         Int                  @default(0)
  lastError        String?              @db.Text
  uploadedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([reviewId])
  @@index([providerConfigId])
  @@index([status])
  @@map("upload_jobs")
}

// ---------------------------------------------------------------------------
// Bulk generation + logs
// ---------------------------------------------------------------------------

enum BulkGenerationScope {
  PRODUCT
  SELECTED
  COLLECTION
  STORE
}

enum BulkGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BulkGenerationJob {
  id             String               @id @default(cuid())
  storeId        String
  store          ShopifyStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scope          BulkGenerationScope
  targetIds      Json
  status         BulkGenerationStatus @default(PENDING)
  totalCount     Int                  @default(0)
  completedCount Int                  @default(0)
  failedCount    Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([storeId])
  @@map("bulk_generation_jobs")
}

model AiSettings {
  id              String       @id @default(cuid())
  storeId         String       @unique
  store           ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  apiKeyEncrypted String?      @db.Text
  models          String[]     @default([])
  enabled         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("ai_settings")
}

enum DuplicateCheckStatus {
  PENDING
  RUNNING
  AWAITING_CONFIRMATION
  COMPLETED
  DISMISSED
  FAILED
}

enum DuplicateCheckMode {
  EXACT
  AI
}

model DuplicateCheckJob {
  id                        String               @id @default(cuid())
  storeId                   String
  store                     ShopifyStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scope                     String
  limitCount                Int?
  checkMode                 DuplicateCheckMode   @default(EXACT)
  status                    DuplicateCheckStatus @default(PENDING)
  totalCount                Int                  @default(0)
  scannedCount              Int                  @default(0)
  totalToDelete             Int                  @default(0)
  deletedCount              Int                  @default(0)
  contentDuplicatesRemoved  Int                  @default(0)
  reviewerDuplicatesRemoved Int                  @default(0)
  errorMessage              String?              @db.Text
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  flags DuplicateCheckFlag[]

  @@index([storeId])
  @@map("duplicate_check_jobs")
}

enum DuplicateFlagReason {
  CONTENT
  REVIEWER
}

/** One row per review flagged as a likely duplicate during an AI-mode check — persisted so the
 * "preview before delete" flow has something concrete to show and act on, rather than re-running
 * the (costly, non-deterministic) AI scan again at confirm time. EXACT-mode checks don't use this
 * at all — they still auto-delete immediately, same as before. */
model DuplicateCheckFlag {
  id              String              @id @default(cuid())
  jobId           String
  job             DuplicateCheckJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewId        String
  review          GeneratedReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  productId       String
  reason          DuplicateFlagReason
  /** For CONTENT flags, the earlier review in the same product this was judged a near-duplicate
   * of — informational only (not a formal FK, so a since-deleted review doesn't break this row). */
  matchedReviewId String?
  createdAt       DateTime            @default(now())

  @@index([jobId])
  @@map("duplicate_check_flags")
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

model SystemLog {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  level     SystemLogLevel
  message   String
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
}
