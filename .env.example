# ---------------------------------------------------------------------------
# Database
# Docker Postgres is published on host port 5433 (not 5432) to avoid
# colliding with a locally installed Postgres service, if any.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_shopify_review_generator?schema=public"

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# AES-256-GCM key (32 bytes, base64) used to encrypt Shopify access tokens and
# review-provider credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# ---------------------------------------------------------------------------
# Email (password reset). Leave SMTP_* unset in local dev to use the
# console/Ethereal dev transport instead of a real mail provider.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="AI Shopify Review Generator <noreply@example.com>"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Shopify (Phase 4)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,read_collections"
SHOPIFY_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Claude API (Phase 7+)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Worker service
# ---------------------------------------------------------------------------
WORKER_PORT="4000"
