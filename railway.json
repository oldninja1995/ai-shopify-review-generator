{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx -y pnpm@11.10.0 --filter @ai-shopify/worker build"
  },
  "deploy": {
    "startCommand": "npx -y pnpm@11.10.0 --filter @ai-shopify/worker start",
    "restartPolicyType": "ON_FAILURE"
  }
}
